@app.route("/api/chat", methods=["POST"])
def api_chat():
    data = request.get_json(silent=True) or {}
    text = str(data.get("text", "")).strip()
    if not text:
        return jsonify({"reply": "Please type something."})
    reply = ask_openrouter(text)
    return jsonify({"reply": reply})

@app.route("/api/call", methods=["POST"])
def api_call():
    data = request.get_json(silent=True) or {}
    number = str(data.get("number", "")).strip()
    if not number:
        return jsonify({"status": "error", "message": "Number required."})
    return jsonify(termux_call(number))

@app.route("/api/sms", methods=["POST"])
def api_sms():
    data = request.get_json(silent=True) or {}
    number = str(data.get("number", "")).strip()
    message = str(data.get("message", "")).strip()
    if not number or not message:
        return jsonify({"status": "error", "message": "Number and message required."})
    return jsonify(termux_sms(number, message))

