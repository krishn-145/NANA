                print(RED + "AI> " + RESET + result["message"])
                continue

            reply = ask_openrouter(user_input)
            print(RED + "AI> " + RESET + reply)

        except KeyboardInterrupt:
            print("\nExiting...")
            break
        except Exception as error:
            print("❌ Error:", error)

def telegram_mode():
    try:
        import telebot
    except ImportError:
        print("❌ Telegram library missing.")
        print("Run: pip install pyTelegramBotAPI")
        return

    if not TELEGRAM_BOT_TOKEN:
        print("❌ TELEGRAM_BOT_TOKEN missing.")
        print('export TELEGRAM_BOT_TOKEN="YOUR_NEW_TOKEN"')
        return

    bot = telebot.TeleBot(TELEGRAM_BOT_TOKEN)

    @bot.message_handler(commands=["start"])
    def start(message):
        bot.reply_to(
            message,
            "🤖 KRISHN AI BOT ONLINE!\n\n"
            "👑 Owner: Krishn\n"
            "⚡ GitHub: " + GITHUB_URL + "\n\n"
            "Message bhejo aur AI reply karega."
        )

    @bot.message_handler(commands=["help"])
    def help_message(message):
        bot.reply_to(
            message,
            "📚 Krishn AI Help\n\n"
            "Normal message bhejo aur AI reply karega."
        )

    @bot.message_handler(content_types=["text"])
    def handle_message(message):
        try:
            user_text = (message.text or "").strip()
            if not user_text:
                return

            print(CYAN + "\n📩 Telegram: " + RESET + user_text)
            bot.send_chat_action(message.chat.id, "typing")

            reply = ask_openrouter(user_text)
            limit = 4000

            if len(reply) <= limit:
                bot.reply_to(message, reply)
            else:
                for start_index in range(0, len(reply), limit):
                    chunk = reply[start_index:start_index + limit]
                    bot.send_message(message.chat.id, chunk)

            print(GREEN + "✅ Reply sent" + RESET)

        except Exception as error:
            print("❌ Telegram error:", error)
            try:
                bot.reply_to(message, "❌ AI response error.")
            except Exception:
                pass

    print()
    print(GREEN + "╔══════════════════════════════╗" + RESET)
    print(GREEN + "║     TELEGRAM AI ONLINE       ║" + RESET)
    print(GREEN + "╚══════════════════════════════╝" + RESET)
    print("👑 Owner:", OWNER_NAME)
    print("⚡ GitHub:", GITHUB_URL)
    print("🤖 Waiting for Telegram messages...")
    print("🛑 Ctrl+C = Stop")

    try:
        bot.infinity_polling(timeout=30, long_polling_timeout=30, skip_pending=True)
    except KeyboardInterrupt:
        print("\n🛑 Telegram stopped.")
    except Exception as error:
        print("❌ Polling error:", error)

