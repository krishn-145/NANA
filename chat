def ask_openrouter(prompt):
    if not OPENROUTER_API_KEY:
        return "❌ OPENROUTER_API_KEY set nahi hai."

    headers = {
        "Authorization": "Bearer " + OPENROUTER_API_KEY,
        "Content-Type": "application/json",
        "HTTP-Referer": GITHUB_URL,
        "X-Title": "Krishn Termux AI"
    }
    payload = {
        "model": OPENROUTER_MODEL,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": 500
    }

    try:
        response = requests.post(
            "https://openrouter.ai/api/v1/chat/completions",
            headers=headers,
            json=payload,
            timeout=45
        )
        if response.status_code != 200:
            return "❌ OpenRouter HTTP error: " + str(response.status_code)

        data = response.json()
        choices = data.get("choices", [])
        if not choices:
            return "❌ AI ne response nahi diya."

        content = choices[0].get("message", {}).get("content", "")
        return str(content).strip() if content else "❌ Empty AI response."

    except requests.exceptions.Timeout:
        return "❌ OpenRouter timeout."
    except requests.exceptions.RequestException as error:
        return "❌ Network error: " + str(error)
    except Exception as error:
        return "❌ AI error: " + str(error)

def termux_call(number):
    try:
        subprocess.run(["termux-telephony-call", number], check=True, timeout=10)
        return {"status": "success", "message": "📞 Calling " + number}
    except FileNotFoundError:
        return {"status": "error", "message": "❌ Install Termux:API and its package first."}
    except Exception as error:
        return {"status": "error", "message": "❌ Call failed: " + str(error)}

def termux_sms(number, message):
    try:
        subprocess.run(
            ["termux-sms-send", "-n", number, message],
            check=True,
            timeout=10
        )
        return {"status": "success", "message": "✉️ SMS sent to " + number}
    except FileNotFoundError:
        return {"status": "error", "message": "❌ Install Termux:API and its package first."}
    except Exception as error:
        return {"status": "error", "message": "❌ SMS failed: " + str(error)}

